    "prepare:explorer": "node scripts/prepare-explorer.mjs",
    "package:preview": "node scripts/package-preview.mjs",
    "prepare:galaxy": "node scripts/prepare-galaxy.mjs",
    "refresh:curators": "node --env-file=backend/.env scripts/refresh-curators.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "5.9.3"
  },
  "type": "module"
